#!/usr/bin/env bash
# Run a command inside the devkitPro devkitPPC image with this repo mounted
# at /work. Usage: scripts/dkp make -C examples APP=hello
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
IMAGE="${DKP_IMAGE:-devkitpro/devkitppc:latest}"
exec docker run --rm -e PATH=/opt/devkitpro/devkitPPC/bin:/opt/devkitpro/tools/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin -v "$ROOT":/work -w /work "$IMAGE" "$@"
