#!/usr/bin/env bash
# Cross-build a jolt program for the Wii and package it for the Homebrew Channel.
# Usage: scripts/jolt-wii-build <project-dir> <main-ns> <app-name>
#   e.g. scripts/jolt-wii-build jolt-hello hello.core jolt-hello
# Prereqs: scripts/setup-chez, scripts/dkp make -C chez-wii runtime, scripts/make-pack.
# Output: <project-dir>/build/<app-name>.dol and build/sd/apps/<app-name>/boot.dol
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PROJ="$(cd "$1" && pwd)"; NS="$2"; APP="$3"
PACK="${JOLT_WII_PACK:-$ROOT/.work/pack-tpb32b}"
cd "$PROJ"
rm -rf "build/$APP.elf" "build/$APP.elf.build"
mkdir -p build
# JOLT_NARROW_HASH=1: jolt picks its hash-engine width at expand time on the
# COMPILING (64-bit) Chez; this forces the 32-bit-safe arm for the Wii.
JOLT_NARROW_HASH=1 \
JOLT_CHEZ="$ROOT/.work/ChezScheme/$(ls "$ROOT/.work/ChezScheme/" | grep -E '^t(arm64|a6)osx$' | head -1)/bin/$(ls "$ROOT/.work/ChezScheme/" | grep -E '^t(arm64|a6)osx$' | head -1)/scheme" \
JOLT_TARGET_CC="${JOLT_WII_CC:-$ROOT/scripts/wii-cc}" \
  jolt build -m "$NS" -o "build/$APP.elf" --target tpb32b --target-pack "$PACK"
"$ROOT/scripts/dkp" elf2dol "${PROJ#$ROOT/}/build/$APP.elf" "${PROJ#$ROOT/}/build/$APP.dol"
mkdir -p "build/sd/apps/$APP"
cp "build/$APP.dol" "build/sd/apps/$APP/boot.dol"
# JOLT_WII_NO_META=1: measurement builds are not apps, so they get no Homebrew Channel meta.xml.
[ -f meta.xml ] && [ -z "${JOLT_WII_NO_META:-}" ] && cp meta.xml "build/sd/apps/$APP/" || true
ls -la "build/$APP.dol"
