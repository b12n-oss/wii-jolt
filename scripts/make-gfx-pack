#!/usr/bin/env bash
# Derive .work/pack-tpb32b-gfx from the plain pack: no text-console runtime
# (raylib owns the screen), plus the jolt-gfx shim, raylib and SDL.
# Prereqs: bb pack, bb build:jolt-gfx, bb build:raylib.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$ROOT/.work/pack-tpb32b"; PACK="${1:-$ROOT/.work/pack-tpb32b-gfx}"
[ -e "$SRC/xpatch" ] || { echo "the plain pack is missing: run bb pack first" >&2; exit 1; }
for f in "$ROOT/jolt-gfx/build/jolt_gfx.o" "$ROOT/raylib-wii/build/wii_shim.o" "$ROOT/raylib-wii/build/libraylib.a"; do
  [ -e "$f" ] || { echo "missing: $f (bb build:jolt-gfx, bb build:raylib)" >&2; exit 1; }
done
rm -rf "$PACK"; cp -R "$SRC" "$PACK"
rm -f "$PACK/lib/wii_runtime.o"
sed "s|$SRC/xpatch.chez|$PACK/xpatch.chez|" "$SRC/xpatch" > "$PACK/xpatch"
cp "$ROOT/jolt-gfx/build/jolt_gfx.o" "$ROOT/raylib-wii/build/wii_shim.o" "$PACK/lib/"
W=/opt/devkitpro/portlibs/wii/lib
printf '%s\n' "$PACK/lib/jolt_gfx.o $PACK/lib/wii_shim.o $PACK/lib/posix_stubs.o $PACK/lib/ogc_tls.o -Wl,--wrap=Sbuild_heap -Wl,--wrap=KEYBOARD_Init -Wl,--wrap=KEYBOARD_GetEvent -L$ROOT/raylib-wii/build -lraylib -L$W -lSDL2main -lSDL2 -laesnd -lopengx -lfat -lwiiuse -lbte -lwiikeyboard -llz4 -lz -lpthread -logc -lstdc++ -lm" > "$PACK/link-libs"
echo "wrote target pack: $PACK"
cat "$PACK/link-libs"
