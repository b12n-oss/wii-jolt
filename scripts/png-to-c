#!/bin/sh
# Usage: scripts/png-to-c OUT.h NAME=FILE...
# Writes a C header holding each FILE as `static const unsigned char NAME[]`
# plus `static const unsigned int NAME_len`.
set -eu
[ $# -ge 2 ] || { echo "usage: $0 OUT.h NAME=FILE..." >&2; exit 2; }
out=$1; shift
{
  echo "// Generated by scripts/png-to-c. Do not edit."
  echo "// Regenerate: scripts/png-to-c $out $*"
  for pair in "$@"; do
    name=${pair%%=*}; file=${pair#*=}
    [ -f "$file" ] || { echo "no such file: $file" >&2; exit 1; }
    echo "static const unsigned char $name[] = {"
    xxd -i < "$file"
    echo "};"
    echo "static const unsigned int ${name}_len = $(wc -c < "$file" | tr -d ' ');"
  done
} > "$out"
