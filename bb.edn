{:min-bb-version "1.3.0"

 :tasks
 {:requires ([babashka.fs :as fs]
             [babashka.process :as p]
             [babashka.process :refer [shell]]
             [clojure.string :as str])

  :init
  (do
    ;; bb sets babashka.version, jolt sets jolt.version.
    (def runner (if (System/getProperty "babashka.version") "bb" "jolt"))
    (def repo-root (str (fs/parent (fs/absolutize "bb.edn"))))
    (defn auto-user
      "Write a scripted (or play) Wiimote profile and return its Dolphin user dir."
      [profile]
      (str/trim (:out (shell {:dir repo-root :out :string} "scripts/dolphin-auto-wiimote" profile))))
    (def shots-dir (str repo-root "/.work/shots"))

    ;; One row per thing that runs on the Wii:
    ;; [name dol-path console? what-it-shows]
    ;; console? = the app draws with libogc's text console (CPU-written
    ;; framebuffer), which Dolphin only shows with XFB-to-texture off.
    (def apps
      [["balloons"    "examples/build/balloons/balloons.dol"       false "Balloon Pop: point a Wiimote, press A, up to 4 players"]
       ["starcatcher" "examples/build/starcatcher/starcatcher.dol" false "Star Catcher: tilt the Wiimote to catch stars"]
       ["shakerace"   "examples/build/shakerace/shakerace.dol"     false "Shake Race: shake the Wiimote to run"]
       ["hello"      "examples/build/hello/hello.dol"     false "stock raylib 6.0: bouncing ball, gamepad readout"]
       ["chez"       "chez-wii/build/chez.dol"            true  "Chez Scheme 10.4.1 (tpb32b) evaluating a test list"]
       ["jolt-hello" "jolt-hello/build/jolt-hello.dol"    true  "Clojure via jolt: fib, bignums, maps, sets, hashes"]])

    (defn app [nm] (first (filter (fn [a] (= nm (first a))) apps)))

    (defn sh! [& args]
      (let [r (apply shell {:dir repo-root :continue true} args)]
        (when-not (zero? (:exit r))
          (binding [*out* *err*] (println "failed:" (str/join " " args)))
          (System/exit (:exit r)))))

    (defn osreport-lines
      "The program's stdout/stderr lines (OSREPORT) from a Dolphin log file."
      [log-file]
      (->> (str/split-lines (if (fs/exists? log-file) (slurp log-file) ""))
           (filter (fn [l] (str/includes? l "N[OSREPORT]: ")))
           (map (fn [l] (str/replace (subs l (+ (str/index-of l "N[OSREPORT]: ") 13)) "\r" "")))))

    (defn run-in-dolphin
      "Boot an app in Dolphin (MMU emulation on), screenshot it, return the
       OSREPORT lines (the program's stdout/stderr) from Dolphin's log.
       Without :user it uses the `idle` profile: a Wiimote with nothing bound.
       Never Dolphin's default profile, which maps the Mac's own mouse and
       keyboard, and dolphin-shot turns on background input, so whatever the
       person at the Mac is doing would reach the game."
      [nm seconds & {:keys [user shot-name]}]
      (let [[_ dol console?] (app nm)
            user (or user (auto-user "idle"))
            shot (str shots-dir "/" (or shot-name nm) ".png")
            log-file (str user "/Logs/dolphin.log")]
        (fs/create-dirs shots-dir)
        (when-not (fs/exists? (fs/file repo-root dol))
          (binding [*out* *err*] (println (str "not built: " dol "   (try: " runner " build:" nm ")")))
          (System/exit 1))
        (shell {:dir repo-root :continue true
                :extra-env (merge (if console? {"DOLPHIN_EXTRA" "-C GFX.Hacks.XFBToTextureEnable=False"} {})
                                  {"DOLPHIN_USER" user})}
               "scripts/dolphin-shot" dol shot (str seconds))
        (let [log (if (fs/exists? log-file) (slurp log-file) "")]
          {:shot shot
           :crashed? (boolean (re-find (re-pattern "Exception \\(DSI\\)|Invalid (read|write)") log))
           :lines (osreport-lines log-file)})))
    ;; The games: [name scripted-wiimote-profile log-line-for-a-score how-it's-played language].
    ;; Each has examples/<name>/game.c with host tests in test/test_game.c, and
    ;; prints "<name>: mode <m>" and one line per score to Dolphin's log.
    (def games
      [["balloons"    "pointer" "pop player=1 "    "point and press A" :c]
       ["starcatcher" "tilt"    "catch player=1 "  "tilt sideways (or arrow keys)" :c]
       ["shakerace"   "shake"   "finish player=1 " "shake (space bar on the Mac)" :c]])

    (defn game-lines [nm r]
      (let [prefix (str nm ": ")]
        (->> (:lines r) (filter (fn [l] (str/starts-with? l prefix))) (map (fn [l] (subs l (count prefix)))) vec)))

    (defn run-scripted
      "Boot a game with its scripted Wiimote profile; returns run-in-dolphin's map."
      [nm]
      (let [[_ profile] (first (filter (fn [gm] (= nm (first gm))) games))]
        (run-in-dolphin nm 40 :user (auto-user profile) :shot-name (str nm "-wiimote"))))

    (defn scripted-pass?
      "The scripted remote joined (countdown), the round started, and player 1
       scored during it."
      [nm r]
      (let [[_ _ score-line] (first (filter (fn [gm] (= nm (first gm))) games))
            ls (game-lines nm r)
            play-mode (if (= nm "shakerace") "race" "play")]
        (and (not (:crashed? r))
             (some (fn [l] (= l "mode countdown")) ls)
             (some (fn [l] (= l (str "mode " play-mode))) ls)
             (some (fn [l] (and (str/starts-with? l score-line) (str/ends-with? l (str "mode=" play-mode)))) ls))))

    (defn demo-pass?
      "Title, then the robot demo scores at least three times."
      [nm r]
      (let [ls (game-lines nm r)]
        (and (not (:crashed? r))
             (some (fn [l] (= l "mode demo")) ls)
             (>= (count (filter (fn [l] (str/ends-with? l "mode=demo")) ls)) 3))))

    (defn print-game-run [nm r]
      (doseq [l (game-lines nm r)] (println (str nm ": " l)))
      (println (:shot r)))

    (defn sd-sync-opts
      "Dolphin flags for an emulated SD card built from folder `dir` (copied
       back to the Mac when Dolphin shuts down), so settings.txt saves work."
      [dir]
      (fs/create-dirs dir)
      ["-C" "Dolphin.Core.WiiSDCard=True" "-C" "Dolphin.Core.WiiSDCardEnableFolderSync=True"
       "-C" (str "Dolphin.General.WiiSDCardSyncFolder=" dir) "-C" "Dolphin.Core.WiiSDCardAllowWrites=True"])

    ;; The couch settings: [game remote-button-profile settings-key value-after-one-press]
    (def couch-settings
      [["starcatcher" "minus" "tilt_sign" "1"]
       ["shakerace"   "plus"  "shake_level" "4"]])

    (defn couch-check
      "Press the setting's button once on the title screen with an emulated SD
       card, then relaunch with no presses. Passes if the first run saved and
       the second started with the new value."
      [[nm profile k v]]
      (let [sd (str repo-root "/.work/sd-couch")
            extra (str/join " " (sd-sync-opts sd))
            boot (fn [prof shot]
                   (let [user (auto-user prof)]
                     (shell {:dir repo-root :continue true :out :string
                             :extra-env {"DOLPHIN_USER" user "DOLPHIN_EXTRA" extra}}
                            "scripts/dolphin-shot" (str "examples/build/" nm "/" nm ".dol")
                            (str shots-dir "/" shot ".png") "5.5")
                     (game-lines nm {:lines (osreport-lines (str user "/Logs/dolphin.log"))})))]
        (fs/delete-tree sd)
        (fs/create-dirs (str sd "/apps/" nm))
        (let [first-run (boot profile (str nm "-couch"))
              second-run (boot "idle" (str nm "-couch-reload"))]
          {:saved? (boolean (some (fn [l] (= l (str "setting " k "=" v " saved=1"))) first-run))
           :loaded? (boolean (some (fn [l] (and (str/starts-with? l "start ") (str/includes? l (str k "=" v " ")))) second-run))
           :file (let [f (str sd "/apps/" nm "/settings.txt")] (when (fs/exists? f) (str/trim (slurp f))))})))

    (defn play-game
      "Open a game in Dolphin for a person to play with the Mac."
      [nm]
      (let [dol (str repo-root "/examples/build/" nm "/" nm ".dol")]
        (when-not (fs/exists? dol) (run (symbol (str "build:" nm))))
        (fs/create-dirs (str repo-root "/.work/sd-play/apps/" nm))
        (apply shell {:dir repo-root} "/Applications/Dolphin.app/Contents/MacOS/Dolphin"
               "-u" (auto-user "play") "-e" dol
               "-C" "Dolphin.Core.MMU=True" "-C" "Dolphin.Analytics.PermissionAsked=True"
               (sd-sync-opts (str repo-root "/.work/sd-play")))))


    (def docs-engine-repo "https://github.com/jlt-commons/docs-engine")

    (defn docs-engine-dir
      "Where the engine is checked out: $DOCS_ENGINE, else a sibling
       directory, else the usual spot. nil when none of them exist."
      []
      (let [home (System/getProperty "user.home")]
        (->> [(System/getenv "DOCS_ENGINE")
              "../docs-engine"
              (str home "/dev/jlt-commons/docs-engine")]
             (remove nil?)
             (filter (fn [d] (fs/exists? (fs/file d "bb.edn"))))
             first)))

    (defn site-task
      "Runs one of the engine's tasks against this project. LOCAL PREVIEW
       ONLY: builds into _site/ and serves on localhost. Nothing here
       publishes anything or enables GitHub Pages."
      [task & args]
      (if-let [engine (docs-engine-dir)]
        (let [argv (into ["bb" task repo-root] (remove nil? args))
              res  (apply p/shell {:dir (str engine) :continue true} argv)]
          (when-not (zero? (:exit res)) (System/exit (:exit res))))
        (do
          (println "The docs engine is not checked out anywhere I looked:")
          (println "  $DOCS_ENGINE, ../docs-engine, ~/dev/jlt-commons/docs-engine")
          (println)
          (println "  git clone" docs-engine-repo "../docs-engine")
          (System/exit 1)))))

  info
  {:doc "Grouped task cheat-sheet (start here; easier to scan than `tasks`)"
   :task
   (let [esc (str (char 27) "[")
         col (fn [c s] (str esc c "m" s esc "0m"))
         hdr (fn [s] (println (str "\n" (col "35" (str "-- " s " --")))))
         row (fn [t d] (println (str "  " (col "36" (format "%-28s" (str runner " " t))) d)))]
     (println (col "1;35" "\nwii-jolt: raylib, Chez Scheme and Clojure (jolt) on the Nintendo Wii"))
     (println (col "2" (str "  runner: " runner "   ·   both `bb <task>` and `jolt <task>` work")))
     (hdr "Verify")
     (row "doctor" "check Docker, the devkitPPC image, Dolphin, jolt, Chez")
     (row "test" "host-side unit tests: every game's rules, on the Mac")
     (row "verify" "build everything, boot each app in Dolphin (MMU on), check output")
     (hdr "Build")
     (row "build" "every app below")
     (row "build:hello" "raylib for the Wii, then the raylib hello app")
     (row "build:balloons" "Balloon Pop")
     (row "build:starcatcher" "Star Catcher")
     (row "build:shakerace" "Shake Race")
     (row "chez:setup" "one-time: Chez 10.4.1 + Wii patch, host compiler, tpb32b boots")
     (row "build:chez" "the Chez kernel for the Wii and the chez test app")
     (row "pack" "assemble the jolt target pack for tpb32b")
     (row "build:jolt-hello" "cross-build jolt-hello with jolt build --target tpb32b")
     (row "sd" "collect every built app into build/sd/apps for an SD card")
     (hdr "Run in Dolphin")
     (doseq [[nm _ _ what] apps] (row (str "run:" nm) what))
     (doseq [[nm profile] games] (row (str "run:" nm "-wiimote") (str "a round with a scripted Wiimote (" profile ")")))
     (row "run:couch" "press each game's couch setting, check it saves and reloads")
     (hdr "Play on the Mac (Dolphin; Return = HOME)")
     (doseq [[nm _ _ how] games] (row (str "play:" nm) how))
     (hdr "Docs")
     (row "site:build" "build the docs site into _site/ (local preview)")
     (row "site:serve" "build and serve it on localhost (default port 3000)")
     (row "site:clean" "delete _site/")
     (println (str "\n" (col "2" (str "first run: " runner " doctor, then " runner " chez:setup, then " runner " verify")))))}

  doctor
  {:doc "Check every external dependency and say what each one blocks"
   :task
   (let [ok   (fn [s] (println (str "  ok    " s)))
         bad  (fn [s fix] (println (str "  MISS  " s "\n        -> " fix)))
         home (System/getProperty "user.home")
         docker? (fs/which "docker")
         daemon? (and docker? (zero? (:exit (p/shell {:out :string :err :string :continue true} "docker" "info"))))
         image?  (and daemon? (zero? (:exit (p/shell {:out :string :err :string :continue true}
                                                     "docker" "image" "inspect" "devkitpro/devkitppc:latest"))))
         problems (atom 0)
         check (fn [pass? s fix] (if pass? (ok s) (do (swap! problems inc) (bad s fix))))]
     (println "toolchain (blocks every build):")
     (check docker? "docker on PATH" "install Docker Desktop")
     (check daemon? "docker daemon running" "start Docker Desktop")
     (check image? "devkitpro/devkitppc:latest pulled" "docker pull devkitpro/devkitppc:latest")
     (println "testing (blocks run:* and verify):")
     (check (fs/exists? "/Applications/Dolphin.app") "Dolphin emulator" "brew install --cask dolphin")
     (println "Chez Scheme (blocks build:chez, pack, build:jolt-hello):")
     (check (fs/exists? (str home "/dev/ChezScheme/.git")) "~/dev/ChezScheme checkout (source for chez:setup)"
            "clone cisco/ChezScheme with submodules, or set CHEZ_SRC for scripts/setup-chez")
     (check (fs/exists? (str repo-root "/.work/ChezScheme/boot/tpb32b/petite.boot")) "tpb32b boot files built"
            (str runner " chez:setup"))
     (println "jolt (blocks pack users: build:jolt-hello):")
     (check (fs/which "jolt") "jolt on PATH" "install jolt (https://github.com/jolt-lang/jolt)")
     (check (fs/exists? (str repo-root "/.work/pack-tpb32b/xpatch")) "jolt target pack assembled"
            (str runner " build:chez && " runner " pack"))
     (println "docs (blocks site:*):")
     (check (docs-engine-dir) "docs-engine checkout" (str "git clone " docs-engine-repo " ../docs-engine"))
     (println)
     (if (zero? (deref problems))
       (println "all good")
       (do (println (str (deref problems) " missing; fix the first one listed and re-run " runner " doctor"))
           (System/exit 1))))}

  build:raylib
  {:doc "Build vendor/raylib as libraylib.a for the Wii (SDL2 + OpenGX)"
   :task (sh! "scripts/dkp" "make" "-C" "raylib-wii")}

  test
  {:doc "Host-side unit tests: every game's rules compiled and run on the Mac"
   :task (do
          (fs/create-dirs (str repo-root "/.work"))
          (sh! "cc" "-std=c99" "-Wall" "-Wextra" "-Werror" "-Iexamples/common" "examples/common/settings.c"
               "examples/common/test/test_settings.c" "-lm" "-o" (str repo-root "/.work/test_settings"))
          (sh! (str repo-root "/.work/test_settings") (str repo-root "/.work/test_settings.tmp"))
          (doseq [[nm _ _ _ lang] games :when (= lang :c)]
           (let [bin (str repo-root "/.work/test_" nm)]
             (fs/create-dirs (str repo-root "/.work"))
             (sh! "cc" "-std=c99" "-Wall" "-Wextra" "-Werror" (str "-Iexamples/" nm)
                  (str "examples/" nm "/game.c") (str "examples/" nm "/test/test_game.c") "-lm" "-o" bin)
             (sh! bin)))
          (let [r (shell {:dir (str repo-root "/jolt-balloons") :continue true}
                         "jolt" "-A:test" "-m" "balloons.rules-test")]
            (when-not (zero? (:exit r))
              (binding [*out* *err*] (println "failed: jolt -A:test -m balloons.rules-test"))
              (System/exit (:exit r)))))}

  build:balloons
  {:doc "Build Balloon Pop (.dol + SD layout)"
   :depends [build:raylib]
   :task (sh! "scripts/dkp" "make" "-C" "examples" "APP=balloons")}

  build:starcatcher
  {:doc "Build Star Catcher (.dol + SD layout)"
   :depends [build:raylib]
   :task (sh! "scripts/dkp" "make" "-C" "examples" "APP=starcatcher")}

  build:shakerace
  {:doc "Build Shake Race (.dol + SD layout)"
   :depends [build:raylib]
   :task (sh! "scripts/dkp" "make" "-C" "examples" "APP=shakerace")}

  build:hello
  {:doc "Build the raylib hello app (.dol + SD layout)"
   :depends [build:raylib]
   :task (sh! "scripts/dkp" "make" "-C" "examples" "APP=hello")}

  chez:setup
  {:doc "One-time: clone Chez v10.4.1 locally, apply the Wii patch, build host Chez + tpb32b boots"
   :task (sh! "scripts/setup-chez")}

  build:chez
  {:doc "Build the Chez kernel for the Wii, the chez test app and the jolt runtime objects"
   :task (sh! "scripts/dkp" "make" "-C" "chez-wii" "-j8")}

  pack
  {:doc "Assemble the jolt target pack for tpb32b in .work/pack-tpb32b"
   :task (sh! "scripts/make-pack")}

  build:jolt-hello
  {:doc "Cross-build jolt-hello for the Wii with jolt build --target tpb32b"
   :task (sh! "scripts/jolt-wii-build" "jolt-hello" "hello.core" "jolt-hello")}

  build
  {:doc "Build every app"
   :task (do (run 'build:hello) (run 'build:balloons) (run 'build:starcatcher) (run 'build:shakerace) (run 'build:chez) (run 'pack) (run 'build:jolt-hello))}

  sd
  {:doc "Collect every built app into build/sd/apps/<name>/ (copy build/sd/apps to the SD card's root)"
   :task
   (let [out (str repo-root "/build/sd/apps")]
     (doseq [[nm dol] apps]
       (let [src (fs/file repo-root dol)
             dst (fs/file out nm)]
         (if (fs/exists? src)
           (do (fs/create-dirs dst)
               (fs/copy src (fs/file dst "boot.dol") {:replace-existing true})
               (doseq [m [(str (fs/parent dol) "/../../" nm "/meta.xml")
                          (str nm "/meta.xml")
                          (str (fs/parent (fs/parent dol)) "/meta.xml")]]
                 (when (fs/exists? (fs/file repo-root m))
                   (fs/copy (fs/file repo-root m) (fs/file dst "meta.xml") {:replace-existing true})))
               (println "  apps/" nm "/boot.dol"))
           (println "  skipped" nm "(not built)"))))
     (println "copy" out "to the root of the SD card (or USB drive)"))}

  run:balloons
  {:doc "Boot Balloon Pop in Dolphin, wait for the robot demo, print its events"
   :task (print-game-run "balloons" (run-in-dolphin "balloons" 20))}

  run:starcatcher
  {:doc "Boot Star Catcher in Dolphin, wait for the robot demo, print its events"
   :task (print-game-run "starcatcher" (run-in-dolphin "starcatcher" 20))}

  run:shakerace
  {:doc "Boot Shake Race in Dolphin, wait for the robot demo, print its events"
   :task (print-game-run "shakerace" (run-in-dolphin "shakerace" 20))}

  run:balloons-wiimote
  {:doc "A round of Balloon Pop with a scripted Wiimote: A to join, the pointer sweeps"
   :task (print-game-run "balloons" (run-scripted "balloons"))}

  run:starcatcher-wiimote
  {:doc "A round of Star Catcher with a scripted Wiimote: A to join, tipped left and right"
   :task (print-game-run "starcatcher" (run-scripted "starcatcher"))}

  run:shakerace-wiimote
  {:doc "A race in Shake Race with a scripted Wiimote: A to join, shaken 1 s in every 2"
   :task (print-game-run "shakerace" (run-scripted "shakerace"))}

  run:couch
  {:doc "Press each game's couch-setting button in Dolphin, check it saves to an emulated SD card and reloads"
   :task (doseq [c couch-settings]
           (let [r (couch-check c)] (println (first c) r)))}

  play:balloons
  {:doc "Play Balloon Pop in Dolphin: the mouse is the pointer, left click = A, Return = HOME"
   :task (play-game "balloons")}

  play:starcatcher
  {:doc "Play Star Catcher in Dolphin: left click or 2 joins, arrow keys steer, Return = HOME"
   :task (play-game "starcatcher")}

  play:shakerace
  {:doc "Play Shake Race in Dolphin: left click joins, hold the space bar to shake, Return = HOME"
   :task (play-game "shakerace")}

  run:hello
  {:doc "Boot the raylib hello app in Dolphin and screenshot it"
   :task (println (:shot (run-in-dolphin "hello" 12)))}

  run:chez
  {:doc "Boot the Chez Scheme test app in Dolphin and print its output"
   :task (let [r (run-in-dolphin "chez" 25)] (doseq [l (:lines r)] (println l)) (println (:shot r)))}

  run:jolt-hello
  {:doc "Boot jolt-hello in Dolphin and print its output"
   :task (let [r (run-in-dolphin "jolt-hello" 40)] (doseq [l (:lines r)] (println l)) (println (:shot r)))}

  verify
  {:doc "Build everything, boot each app in Dolphin with MMU on, check its output"
   :depends [build]
   :task
   (let [fails (atom [])
         expect (fn [nm pass? what]
                  (println (str (if pass? "  PASS  " "  FAIL  ") nm ": " what))
                  (when-not pass? (swap! fails conj nm)))
         _ (run 'test)
         game-runs (vec (for [[nm] games] [nm (run-in-dolphin nm 20) (run-scripted nm)]))
         couch-runs (vec (for [c couch-settings] [c (couch-check c)]))
         h (run-in-dolphin "hello" 12)
         c (run-in-dolphin "chez" 25)
         j (run-in-dolphin "jolt-hello" 40)
         expected (str/split-lines (slurp (str repo-root "/jolt-hello/expected-output.txt")))
         jl (vec (:lines j))
         start (.indexOf jl (first expected))
         got (if (neg? start) [] (subvec jl start (min (count jl) (+ start (count expected)))))]
     (println "results:")
     (doseq [[nm demo scripted] game-runs]
       (expect nm (demo-pass? nm demo) "title, then the robot demo scores at least 3 times, no crash")
       (expect (str nm "-wiimote") (scripted-pass? nm scripted)
               "a scripted Wiimote presses A to join, the round starts, and player 1 scores in it"))
     (doseq [[[nm _ k v] r] couch-runs]
       (expect (str nm "-couch") (and (:saved? r) (:loaded? r) (= (:file r) (str k "=" v)))
               (str "one button press sets " k "=" v ", it's saved to the SD card, and the next launch loads it")))
     (expect "hello" (and (not (:crashed? h))
                          (some (fn [l] (str/includes? l "PLATFORM: DESKTOP (SDL2): Initialized successfully")) (:lines h)))
             "raylib initialised over SDL2/OpenGX, no crash")
     (expect "chez" (and (not (:crashed? c))
                         (some (fn [l] (= (str/trim l) "=> 144")) (:lines c))
                         (some (fn [l] (= (str/trim l) "=> from-thread")) (:lines c)))
             "every test evaluated, threads and runtime eval included, no crash")
     (expect "jolt-hello" (and (not (:crashed? j)) (= got expected))
             (str "output matches jolt-hello/expected-output.txt (" (count got) "/" (count expected) " lines)"))
     (when (seq (deref fails)) (System/exit 1)))}

  site:build {:doc  "Build the documentation site into _site/ (needs a docs-engine checkout)"
              :task (site-task "build")}

  site:serve {:doc  "Build the docs site and serve it locally (bb site:serve [port], default 3000)"
              :task (site-task "serve" (first *command-line-args*))}

  site:clean {:doc  "Delete the _site/ build output"
              :task (site-task "clean")}}}
