  compare:balloons
  {:doc "Run Balloon Pop in C and in Clojure in Dolphin (45 s demo, a scripted round of 64.5 s or 70 s) and print one comparison table"
   :depends [build:balloons build:jolt-balloons]
   :task
   (let [gs ["balloons" "jolt-balloons"]
         profile (fn [nm] (second (first (filter (fn [gm] (= nm (first gm))) games))))
         ;; Seconds per game, measured 2026-11-03 (probe runs, wall-clock log stamps):
         ;; title: jolt-balloons boots ~7 s before its first frame, so 5 s is black;
         ;; round: the results screen shows for 2 s (C at 64-66 s after launch, jolt at
         ;; 70-72 s; the screenshot lands 1-3 s after the wait, so C waits 64.5: shots at 63 and 66 landed 1 s before and 2.5 s after the screen) and the game then goes back to the title, so 80 s misses it.
         title-secs {"balloons" 5 "jolt-balloons" 12}
         round-secs {"balloons" 64.5 "jolt-balloons" 70}
         title (into {} (map (fn [nm] [nm (run-in-dolphin nm (title-secs nm) :shot-name (str nm "-compare-title"))]) gs))
         demo (into {} (map (fn [nm] [nm (run-in-dolphin nm 45 :shot-name (str nm "-compare-play"))]) gs))
         round (into {} (map (fn [nm] [nm (run-in-dolphin nm (round-secs nm) :user (auto-user (profile nm))
                                                          :shot-name (str nm "-compare-results"))]) gs))
         cols (concat (map (fn [nm] [(str nm " demo 45s") (compare-column (frame-summaries nm (demo nm)))]) gs)
                      (map (fn [nm] [(str nm " round") (compare-column (frame-summaries nm (round nm)))]) gs))
         dol-size (fn [nm] (fs/size (fs/file repo-root (second (app nm)))))
         glue ["jolt-gfx/jolt_gfx.c" "jolt-gfx/jolt_gfx.h" "jolt-gfx/src/wii/gfx.clj" "jolt-gfx/src/wii/frame_stats.clj"]
         c-loc (count-lines ["examples/balloons/game.h" "examples/balloons/game.c" "examples/balloons/main.c"])
         clj-loc (count-lines ["jolt-balloons/src/balloons/rules.clj" "jolt-balloons/src/balloons/draw.clj" "jolt-balloons/src/balloons/main.clj"])
         glue-c-loc (count-lines (filter (fn [f] (str/ends-with? f ".c")) glue))
         glue-h-loc (count-lines (filter (fn [f] (str/ends-with? f ".h")) glue))
         glue-clj-loc (count-lines (filter (fn [f] (str/ends-with? f ".clj")) glue))
         crashed (filter (fn [[nm r]] (:crashed? r)) (concat title demo round))
         empty-runs (filter (fn [[_ c]] (< (nth c 0) 1)) cols)
         played (into {} (map (fn [nm] [nm (boolean (scripted-pass? nm (round nm)))]) gs))
         pr (fn [label cells] (println (apply str (format "%-34s" label) (map (fn [c] (format "%26s" (str c))) cells))))]
     (println "Balloon Pop, C against Clojure (Dolphin, MMU on). First summary line of each run dropped.")
     (println)
     (pr "" (map first cols))
     (pr ".dol size (bytes)" (map (fn [[nm _]] (dol-size (first (str/split nm (re-pattern " "))))) cols))
     (pr "summary lines used" (map (fn [[_ c]] (nth c 0)) cols))
     (pr "work median (us)" (map (fn [[_ c]] (nth c 2)) cols))
     (pr "work worst, max (us)" (map (fn [[_ c]] (nth c 3)) cols))
     (pr "frame worst, max (us)" (map (fn [[_ c]] (nth c 4)) cols))
     (pr "dropped frames, total" (map (fn [[_ c]] (nth c 1)) cols))
     (pr "scripted round played" (concat (map (fn [_] "n/a") gs) (map (fn [nm] (if (played nm) "yes" "NO")) gs)))
     (println)
     (println "Lines of code (wc -l):")
     (println (str "  balloons:        " c-loc "   examples/balloons/{game.h,game.c,main.c}"))
     (println (str "  jolt-balloons:   " clj-loc "   jolt-balloons/src/balloons/{rules,draw,main}.clj"))
     (println (str "  glue the Clojure game needs, C:        " (+ glue-c-loc glue-h-loc) "   jolt-gfx/jolt_gfx.c, jolt_gfx.h"))
     (println (str "  glue the Clojure game needs, Clojure:  " glue-clj-loc "   jolt-gfx/src/wii/gfx.clj, src/wii/frame_stats.clj"))
     (println)
     (println "Screenshots:")
     (doseq [nm gs]
       (println (str "  " nm ": title " (:shot (title nm)) ", play " (:shot (demo nm)) ", results " (:shot (round nm)))))
     (println (if (seq crashed) (str "CRASH MARKERS in: " (str/join ", " (map first crashed))) "no crash markers"))
     (when (seq empty-runs)
       (println (str "FAILED: no frame-summary line in " (str/join ", " (map first empty-runs))
                     " (the game did not boot, the log is missing, or the window is too short)")))
     (doseq [nm gs :when (not (played nm))]
       (println (str "FAILED: the scripted round of " nm " did not play (no join, no round start or no score)")))
     (when (or (seq crashed) (seq empty-runs) (not (every? true? (vals played))))
       (System/exit 1)))}

