diff --git a/c/expeditor.c b/c/expeditor.c
index 4c015106..c5fffc9b 100644
--- a/c/expeditor.c
+++ b/c/expeditor.c
@@ -18,7 +18,7 @@
 # include "system.h"
 #endif
 
-#ifdef FEATURE_EXPEDITOR
+#if defined(FEATURE_EXPEDITOR) && !defined(__wii__)
 
 /* locally defined functions */
 static IBOOL s_ee_init_term(iptr in, iptr out);
@@ -1432,3 +1432,44 @@ void S_expeditor_init(void) {
 }
 
 #endif /* FEATURE_EXPEDITOR */
+
+#if defined(FEATURE_EXPEDITOR) && defined(__wii__)
+/* No terminal on a Wii. scheme.boot still binds the expeditor's foreign
+   entries when it loads, so register them all against one stub. With
+   ee_init_term answering 0 ("not a terminal") the expeditor is never
+   entered and the rest are never called. */
+static iptr s_ee_wii_stub(void) { return 0; }
+void S_expeditor_init(void) {
+  Sforeign_symbol("(cs)ee_bell", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_carriage_return", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_char_width", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_clear_screen", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_clr_eol", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_clr_eos", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_down", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_enter_am_mode", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_exit_am_mode", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_flush", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_get_clipboard", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_get_screen_size", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_init_term", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_left", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_line_feed", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_nanosleep", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_nopostoutput", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_noraw", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_nosignal", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_pause", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_pending_winch", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_postoutput", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_raw", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_read_char", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_right", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_scroll_reverse", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_set_color", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_signal", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_up", (void *)s_ee_wii_stub);
+  Sforeign_symbol("(cs)ee_write_char", (void *)s_ee_wii_stub);
+}
+#endif
+
