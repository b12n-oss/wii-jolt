diff --git a/c/pb.h b/c/pb.h
index eb6806f8..5a13ad7d 100644
--- a/c/pb.h
+++ b/c/pb.h
@@ -888,15 +888,51 @@ enum {
 #define do_pb_ld_op_pb_int64_pb_immediate(dest, reg, imm) \
   regs[dest] = *(uptr *)TO_VOIDP(regs[reg] + imm)
 
+#ifdef __wii__
+/* The Wii's 750CL raises an alignment exception on a floating-point load or
+   store whose address is not word-aligned (lfd/stfd), where every other host
+   and Dolphin accept it. Scheme code reads doubles from bytevectors at any
+   offset, so a double load or store goes through word copies unless its
+   address is word-aligned. The counters say how often that path ran; the
+   Wii runtime prints them at exit. */
+extern unsigned pb_unaligned_fp_loads, pb_unaligned_fp_stores;
+static inline double pb_ld_double(uptr a) {
+  if ((a & 3) == 0) return *(double *)TO_VOIDP(a);
+  pb_unaligned_fp_loads++;
+  {
+    const uint32_t *s = (const uint32_t *)TO_VOIDP(a);
+    uint32_t w[2]; double d;
+    w[0] = s[0]; w[1] = s[1];
+    memcpy(&d, w, sizeof d);
+    return d;
+  }
+}
+static inline void pb_st_double(uptr a, double d) {
+  if ((a & 3) == 0) { *(double *)TO_VOIDP(a) = d; return; }
+  pb_unaligned_fp_stores++;
+  {
+    uint32_t *t = (uint32_t *)TO_VOIDP(a);
+    uint32_t w[2];
+    memcpy(w, &d, sizeof d);
+    t[0] = w[0]; t[1] = w[1];
+  }
+}
+# define PB_LD_DOUBLE(a) pb_ld_double((uptr)(a))
+# define PB_ST_DOUBLE(a, d) pb_st_double((uptr)(a), (d))
+#else
+# define PB_LD_DOUBLE(a) (*(double *)TO_VOIDP(a))
+# define PB_ST_DOUBLE(a, d) (*(double *)TO_VOIDP(a) = (d))
+#endif
+
 #define doi_pb_ld_op_pb_double_pb_register(instr) \
   do_pb_ld_op_pb_double_pb_register(INSTR_drr_dest(instr), INSTR_drr_reg1(instr), INSTR_drr_reg2(instr))
 #define do_pb_ld_op_pb_double_pb_register(dest, reg1, reg2) \
-  fpregs[dest] = *(double *)TO_VOIDP(regs[reg1] + regs[reg2])
+  fpregs[dest] = PB_LD_DOUBLE(regs[reg1] + regs[reg2])
 
 #define doi_pb_ld_op_pb_double_pb_immediate(instr) \
   do_pb_ld_op_pb_double_pb_immediate(INSTR_dri_dest(instr), INSTR_dri_reg(instr), INSTR_dri_imm(instr))
 #define do_pb_ld_op_pb_double_pb_immediate(dest, reg, imm) \
-  fpregs[dest] = *(double *)TO_VOIDP(regs[reg] + imm)
+  fpregs[dest] = PB_LD_DOUBLE(regs[reg] + imm)
 
 #define doi_pb_ld_op_pb_single_pb_register(instr) \
   do_pb_ld_op_pb_single_pb_register(INSTR_drr_dest(instr), INSTR_drr_reg1(instr), INSTR_drr_reg2(instr))
@@ -951,12 +987,12 @@ enum {
 #define doi_pb_st_op_pb_double_pb_register(instr) \
   do_pb_st_op_pb_double_pb_register(INSTR_drr_dest(instr), INSTR_drr_reg1(instr), INSTR_drr_reg2(instr))
 #define do_pb_st_op_pb_double_pb_register(dest, reg1, reg2) \
-  *(double *)TO_VOIDP(regs[reg1] + regs[reg2]) = fpregs[dest]
+  PB_ST_DOUBLE(regs[reg1] + regs[reg2], fpregs[dest])
 
 #define doi_pb_st_op_pb_double_pb_immediate(instr) \
