 #define do_pb_fp_call_arena_in(dest, imm) \
-  *(double *)TO_VOIDP(((uptr)TO_PTR(call_arena) + imm)) = fpregs[dest]
+  PB_ST_DOUBLE((uptr)TO_PTR(call_arena) + imm, fpregs[dest])
 
